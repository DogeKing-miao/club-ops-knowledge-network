{
  "@context": {
    "dsh": "https://example.edu.cn/club-ops#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "rdfs:label": { "@container": "@language" }
  },
  "@id": "dsh:ClubOpsNetwork",
  "@type": "owl:Ontology",
  "rdfs:label": { "zh": "校园社团运营知识网络本体", "en": "Campus Club Operations Knowledge Network Ontology" },
  "dsh:scenario": "校园社团运营（招新、活动、场地、成员、获奖）",
  "dsh:framework": "对象 · 属性 · 关系 · 动作（赛题要求的本体建模思路）",
  "dsh:note": "示例本体，与 data 中的 35 个实体、74 条关系配套；学生姓名、社团名均为虚构示例。（2026-10-07 补 C04 跑者联盟：34 实体 / 73 关系 → 35 实体 / 74 关系）",
  "dsh:statistics": { "objectClasses": 11, "relationTypes": 18, "objects": 35, "relations": 74, "queries": 9, "actions": 4 },

  "dsh:objects": [
    { "@id": "dsh:Club", "@type": "owl:Class", "rdfs:label": { "zh": "社团" },
      "dsh:properties": ["clubId (xsd:string, 唯一)", "name (xsd:string)", "category (xsd:string)", "founded (xsd:date)"],
      "dsh:instances": ["C01 星野天文社", "C02 青蓝辩论社", "C03 拾光摄影社", "C04 跑者联盟"] },
    { "@id": "dsh:Student", "@type": "owl:Class", "rdfs:label": { "zh": "学生" },
      "dsh:properties": ["studentId (唯一)", "name", "grade", "major"],
      "dsh:instances": ["S001 林一舟", "S002 赵敏", "S003 陈嘉禾", "S004 王梓涵", "S005 李思远", "S006 周雨桐", "S007 吴桐", "S008 郑亦航"] },
    { "@id": "dsh:Department", "@type": "owl:Class", "rdfs:label": { "zh": "部门" },
      "dsh:properties": ["deptId (唯一)", "name"], "dsh:instances": ["D01 观测部", "D02 宣传部", "D03 赛事部"] },
    { "@id": "dsh:Teacher", "@type": "owl:Class", "rdfs:label": { "zh": "指导老师" },
      "dsh:properties": ["teacherId (唯一)", "name", "department"], "dsh:instances": ["T01 郭明远", "T02 沈一楠"] },
    { "@id": "dsh:Activity", "@type": "owl:Class", "rdfs:label": { "zh": "活动" },
      "dsh:properties": ["activityId (唯一)", "name", "date (xsd:date)", "capacity (xsd:int)", "remaining (xsd:int)", "status"],
      "dsh:instances": ["A01 秋季观星夜", "A02 新生辩论赛", "A03 校园人像外拍", "A04 夜跑打卡周"] },
    { "@id": "dsh:Venue", "@type": "owl:Class", "rdfs:label": { "zh": "场地" },
      "dsh:properties": ["venueId (唯一)", "name", "capacity (xsd:int)", "building"],
      "dsh:instances": ["V01 东区操场", "V02 学生活动中心 302", "V03 图书馆报告厅"] },
    { "@id": "dsh:InterestTag", "@type": "owl:Class", "rdfs:label": { "zh": "兴趣标签" },
      "dsh:properties": ["tagId (唯一)", "name"], "dsh:instances": ["G01 天文观测", "G02 摄影", "G03 辩论", "G04 长跑"] },
    { "@id": "dsh:Recruitment", "@type": "owl:Class", "rdfs:label": { "zh": "招新计划" },
      "dsh:properties": ["recruitId (唯一)", "name", "quota (xsd:int)", "status"],
      "dsh:instances": ["R01 星野天文社 2025 秋季招新", "R02 拾光摄影社 2025 秋季招新"] },
    { "@id": "dsh:Notice", "@type": "owl:Class", "rdfs:label": { "zh": "通知" },
      "dsh:properties": ["noticeId (唯一)", "title", "publishedAt (xsd:date)"],
      "dsh:instances": ["N01 秋季观星夜开始报名", "N02 校园人像外拍开始报名"] },
    { "@id": "dsh:Award", "@type": "owl:Class", "rdfs:label": { "zh": "获奖" },
      "dsh:properties": ["awardId (唯一)", "name", "year (xsd:int)"],
      "dsh:instances": ["W01 省级天文知识竞赛 二等奖", "W02 校级辩论赛 冠军"] },
    { "@id": "dsh:Term", "@type": "owl:Class", "rdfs:label": { "zh": "学期" },
      "dsh:properties": ["termId (唯一)", "name", "startDate", "endDate"],
      "dsh:instances": ["M01 2025 秋季学期"] }
  ],

  "dsh:relations": [
    { "@id": "dsh:MEMBER_OF", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "加入" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Club", "dsh:cardinality": "多对多",
      "dsh:properties": ["role 职务", "joinDate 入社时间", "status 在册/已退出", "quitDate 退出时间"],
      "dsh:supports": ["F5 成员名单", "F14 成员退出", "F32 跨社团重叠"] },
    { "@id": "dsh:IN_DEPARTMENT", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "隶属部门" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Department", "dsh:supports": ["F2 节点详情"] },
    { "@id": "dsh:BELONGS_TO", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "部门属于社团" },
      "dsh:domain": "dsh:Department", "dsh:range": "dsh:Club", "dsh:supports": ["F1 图谱总览"] },
    { "@id": "dsh:ADVISES", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "指导" },
      "dsh:domain": "dsh:Teacher", "dsh:range": "dsh:Club", "dsh:supports": ["F2", "F5"] },
    { "@id": "dsh:HOSTS", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "举办" },
      "dsh:domain": "dsh:Club", "dsh:range": "dsh:Activity", "dsh:supports": ["F5", "F10"] },
    { "@id": "dsh:HELD_AT", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "举办于场地" },
      "dsh:domain": "dsh:Activity", "dsh:range": "dsh:Venue", "dsh:supports": ["F7 场地占用", "F8 冲突检测"] },
    { "@id": "dsh:SIGNED_UP", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "报名" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Activity",
      "dsh:properties": ["signedAt 报名时间", "status 已报名"], "dsh:supports": ["F6 报名查询", "F12 报名活动"] },
    { "@id": "dsh:ATTENDED", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "签到" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Activity",
      "dsh:supports": ["F6 报名与签到对比（谁报名没来）", "F10 参与记录"] },
    { "@id": "dsh:HAS_TAG", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "感兴趣" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:InterestTag", "dsh:supports": ["F17 兴趣匹配", "F33 报名者匹配"] },
    { "@id": "dsh:TAGGED_WITH", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "社团标签" },
      "dsh:domain": "dsh:Club", "dsh:range": "dsh:InterestTag", "dsh:supports": ["F17", "F22 社团相似度", "F33"] },
    { "@id": "dsh:APPLIED_TO", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "报名招新" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Recruitment",
      "dsh:properties": ["status 待审核/已通过/已拒绝", "submittedAt 提交时间"],
      "dsh:supports": ["F9 招新转化", "F11 加入社团", "F33 报名者筛选"] },
    { "@id": "dsh:FOR_CLUB", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "招新归属社团" },
      "dsh:domain": "dsh:Recruitment", "dsh:range": "dsh:Club", "dsh:supports": ["F9", "F33"] },
    { "@id": "dsh:PUBLISHES", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "发布通知" },
      "dsh:domain": "dsh:Club", "dsh:range": "dsh:Notice", "dsh:supports": ["F2"] },
    { "@id": "dsh:ANNOUNCES", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "通知关联活动" },
      "dsh:domain": "dsh:Notice", "dsh:range": "dsh:Activity", "dsh:supports": ["F2", "F6"] },
    { "@id": "dsh:WON", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "获得奖项" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Award", "dsh:supports": ["F10", "F31 荣誉回溯"] },
    { "@id": "dsh:AWARDED_TO", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "奖项归属社团" },
      "dsh:domain": "dsh:Award", "dsh:range": "dsh:Club", "dsh:supports": ["F31"] },
    { "@id": "dsh:ORGANIZED", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "组织活动" },
      "dsh:domain": "dsh:Student", "dsh:range": "dsh:Activity", "dsh:supports": ["F10 履历里的组织经历"] },
    { "@id": "dsh:IN_TERM", "@type": "owl:ObjectProperty", "rdfs:label": { "zh": "属于学期" },
      "dsh:domain": "dsh:Activity", "dsh:range": "dsh:Term", "dsh:supports": ["F18 活跃度", "F20 截止提醒的时间基准"] }
  ],

  "dsh:scenarios": [
    { "@id": "dsh:ScenarioRecruit", "rdfs:label": { "zh": "招新转化与筛选" },
      "dsh:classes": ["Student", "Recruitment", "Club", "InterestTag"],
      "dsh:path": "学生 -[报名招新]-> 招新计划 -[归属]-> 社团 -[标签]-> 兴趣标签 <-[感兴趣]- 学生",
      "dsh:functions": ["F9 招新转化（谁报名没转正）", "F33 报名者筛选与匹配（按标签算匹配度）", "F17 兴趣匹配（找没入社的人）"],
      "dsh:whyGraph": "匹配度要靠「报名→招新→社团→标签→学生」这条关系链算出来，表格做不动" },
    { "@id": "dsh:ScenarioVenue", "rdfs:label": { "zh": "场地占用与冲突" },
      "dsh:classes": ["Activity", "Venue"],
      "dsh:path": "活动 -[举办于]-> 场地，同场地同日两个活动即冲突",
      "dsh:functions": ["F7 场地占用查询", "F8 场地冲突检测"],
      "dsh:whyGraph": "冲突是「同一节点被多条边指向同一时间点」的问题，用关系匹配一次查出" },
    { "@id": "dsh:ScenarioMember", "rdfs:label": { "zh": "成员履历与流失" },
      "dsh:classes": ["Student", "Club", "Activity", "Award", "Department"],
      "dsh:path": "学生 -[加入/退出]-> 社团；学生 -[报名/签到]-> 活动；学生 -[获得]-> 获奖",
      "dsh:functions": ["F5 成员名单", "F6 报名与签到", "F10 人物参与记录", "F14 成员退出", "F32 跨社团重叠"],
      "dsh:whyGraph": "一个人的完整履历横跨多个实体类型，需多跳查询" }
  ],

  "dsh:actions": [
    { "@id": "dsh:JoinClub", "rdfs:label": { "zh": "学生加入社团" }, "dsh:function": "F11",
      "dsh:precondition": "存在「报名招新」关系且状态为待审核；该学生与该社团之间还没有成员关系",
      "dsh:effect": ["新增 MEMBER_OF 关系（role=成员、status=在册、joinDate=当天）",
                     "报名招新关系 status 改为已通过", "社团在册成员数 +1"] },
    { "@id": "dsh:SignUpActivity", "rdfs:label": { "zh": "学生报名活动" }, "dsh:function": "F12",
      "dsh:precondition": "活动 remaining 大于 0；该学生尚未报名该活动",
      "dsh:effect": ["新增 SIGNED_UP 关系（status=已报名、signedAt=当前时间）", "活动 remaining 减 1；名额满时拒绝并提示"] },
    { "@id": "dsh:LeaveClub", "rdfs:label": { "zh": "成员退出社团" }, "dsh:function": "F14",
      "dsh:precondition": "存在 MEMBER_OF 关系且 status=在册",
      "dsh:effect": ["关系属性改为 status=已退出，写入 quitDate", "关系不删除，历史保留用于流失分析", "社团在册成员数 -1"] },
    { "@id": "dsh:CloseActivity", "rdfs:label": { "zh": "活动结项" }, "dsh:function": "F13 配套",
      "dsh:precondition": "活动 status 为报名中",
      "dsh:effect": ["活动 status 置为已结束", "可据此统计报名未签到名单"] }
  ],

  "dsh:queries": [
    { "@id": "dsh:Q_F5", "rdfs:label": { "zh": "社团成员名单" }, "dsh:function": "F5", "dsh:cypher": "04_queries.cypher 第 1 段" },
    { "@id": "dsh:Q_F6", "rdfs:label": { "zh": "活动报名与签到（谁报名没来）" }, "dsh:function": "F6", "dsh:cypher": "04_queries.cypher 第 2 段" },
    { "@id": "dsh:Q_F7", "rdfs:label": { "zh": "场地占用查询" }, "dsh:function": "F7", "dsh:cypher": "04_queries.cypher 第 3 段" },
    { "@id": "dsh:Q_F8", "rdfs:label": { "zh": "场地冲突检测" }, "dsh:function": "F8", "dsh:cypher": "04_queries.cypher 第 4 段" },
    { "@id": "dsh:Q_F9", "rdfs:label": { "zh": "招新转化查询" }, "dsh:function": "F9", "dsh:cypher": "04_queries.cypher 第 5 段" },
    { "@id": "dsh:Q_F10", "rdfs:label": { "zh": "人物参与记录" }, "dsh:function": "F10", "dsh:cypher": "04_queries.cypher 第 6 段" },
    { "@id": "dsh:Q_F17", "rdfs:label": { "zh": "兴趣匹配推荐" }, "dsh:function": "F17", "dsh:cypher": "04_queries.cypher 第 7 段" },
    { "@id": "dsh:Q_F33", "rdfs:label": { "zh": "报名者筛选与匹配" }, "dsh:function": "F33", "dsh:cypher": "04_queries.cypher 第 8 段" },
    { "@id": "dsh:Q_F32", "rdfs:label": { "zh": "跨社团成员重叠" }, "dsh:function": "F32", "dsh:cypher": "04_queries.cypher 第 9 段" }
  ],

  "dsh:plannedGaps": [
    { "@id": "dsh:GapSkill", "rdfs:label": { "zh": "岗位 / 技能尚未单独建模" },
      "dsh:detail": "用户画像里 P1-7 / P2-5★ / P3-3 反复要求「岗位与技能需求公开」，当前用社团、部门的属性字段承载；下一版应新增 Skill 技能标签类与岗位（Position）类，支撑 F17 / F33 的匹配与详情页展示" },
    { "@id": "dsh:GapWorkload", "rdfs:label": { "zh": "活动频次 / 任务量字段待补" },
      "dsh:detail": "P3-5★ 要求新生能看到「一学期几场活动、每次花多少时间」；下一版给 Club / Activity 补 activityFrequency、effortHours 等字段，供 F2 节点详情展示" }
  ]
}
