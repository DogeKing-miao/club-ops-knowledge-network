// ============================================================
// 07_增量补C04.cypher · 「跑者联盟」增量补丁（可单独执行，不用重建整库）
// ------------------------------------------------------------
// 要修的是什么（判断依据见文件末尾「判断依据」）：
//   A04 夜跑打卡周 这个活动节点一直是有的，缺的是它的**归属社团节点**。
//   `05-待补（还没做的）\还差什么.md` 的审计条目写作「A04 夜跑打卡周
//   没有归属社团（关系里临时挂在 C03 拾光摄影社）」；03_seed_relations.cypher 的 HOSTS 段注释写作
//   「可在实体清单补一个 C04 跑者联盟，再把这条改成 C04」——
//   所以补的是**社团节点 C04 跑者联盟**（不是活动 A04），外加两条关系：
//     ① (C04 跑者联盟)-[:HOSTS]->(A04 夜跑打卡周)   由原来的 C03 改挂过来
//     ② (C04 跑者联盟)-[:TAGGED_WITH]->(G04 长跑)   新增（原来只有 3 个社团有标签）
// ------------------------------------------------------------
// 口径变化：34 实体 / 73 关系  →  35 实体 / 74 关系
// 前置：库要已经有 A04 这个活动节点（即跑过 00_一键运行.cypher 或 02/03 脚本）。
// 用法：整段复制粘进 Neo4j Browser，Ctrl+Enter。
//       第 1 步是**一条**语句（改数据）；第 2、3 步是自检，建议一条一条单独跑，
//       这样结果表格不会被折叠成摘要行，方便截图。
// 可重复执行：全部用 MERGE，重复跑不会多出节点或关系。
// 说明：第 1 步里带一句条件删除（FOREACH + CASE 包起来的 DELETE），删的是**旧的错误关系**
//       C03-[:HOSTS]->A04。不加这句的话，A04 会同时有两个主办社团（C03 与 C04），
//       HOSTS 会变成 5 条、关系总数会变成 75，反而更不对。删除只针对这一条已确认写错的关系，
//       且用 WHERE 排除了 C04；重复执行时 bad 为 null，FOREACH 里的空列表让它变成空操作。
// ============================================================


// ---------- 第 1 步：一条语句完成全部增量（改数据） ----------
MATCH (a4:Activity {activityId:'A04'})
OPTIONAL MATCH (old:Club)-[bad:HOSTS]->(a4)
WHERE old.clubId <> 'C04'
FOREACH (_ IN CASE WHEN bad IS NULL THEN [] ELSE [1] END | DELETE bad)
MERGE (c4:Club {clubId:'C04'})
SET c4.name = '跑者联盟',
    c4.note = '类别：体育健康；成立：2018-04-16；主办 A04 夜跑打卡周（成员未纳入本期 8 人样例）',
    c4.category = '体育健康',
    c4.founded = date('2018-04-16')
MERGE (c4)-[:HOSTS]->(a4)
WITH c4, a4
MATCH (g4:InterestTag {tagId:'G04'})
MERGE (c4)-[:TAGGED_WITH]->(g4);


// ---------- 第 2 步：自检（一条一条单独跑） ----------
// 实体总数：应为 35（原来 34，+1 是 C04 跑者联盟）
MATCH (n) RETURN count(n) AS 实体总数;

// 关系总数：应为 74（原来 73；C04→A04 是从 C03 改挂过来，不增不减；C04→G04 是新增 1 条）
MATCH ()-[r]->() RETURN count(r) AS 关系总数;

// 类型分布：社团应为 4（星野天文社 / 青蓝辩论社 / 拾光摄影社 / 跑者联盟）
MATCH (n) RETURN labels(n)[0] AS 类型, count(*) AS 数量 ORDER BY 数量 DESC;

// HOSTS 应该正好 4 条，且 A04 只出现一次、社团是 C04 跑者联盟（若看到 C03 拾光摄影社，说明第 1 步没跑成功）
MATCH (c:Club)-[:HOSTS]->(a:Activity)
RETURN c.clubId AS 社团编号, c.name AS 主办社团, a.activityId AS 活动编号, a.name AS 活动
ORDER BY 活动编号;

// 关系类型条数：TAGGED_WITH 应为 4（原来 3），HOSTS 仍为 4
MATCH ()-[r]->() RETURN type(r) AS 关系类型, count(*) AS 条数 ORDER BY 条数 DESC;


// ---------- 第 3 步：一行汇总（拍「01-实体数 / 02-关系数」时用，表格更好看） ----------
MATCH (n) WITH count(n) AS 实体总数
MATCH ()-[r]->() WITH 实体总数, count(r) AS 关系总数
OPTIONAL MATCH (c4:Club {clubId:'C04'})
RETURN 实体总数, 关系总数, c4.name AS 补的社团,
       [(c4)-[:HOSTS]->(a) | a.name] AS 主办活动,
       [(c4)-[:TAGGED_WITH]->(g) | g.name] AS 社团标签;


// ============================================================
// 判断依据（为什么补 C04 而不是补 A04）
// ------------------------------------------------------------
// 1) `05-待补（还没做的）\还差什么.md`（审计清单）里那条：`A04 夜跑打卡周目前没有归属社团（关系里临时挂在
//    C03 拾光摄影社）；要严谨可在实体清单补一个 C04 跑者联盟` —— 审计条目里的「A04」是
//    被点名的**活动编号**，而它给的修法就是「补 C04 跑者联盟」。
// 2) 03_seed_relations.cypher 原 HOSTS 段注释：`A04 夜跑打卡周 在原实体清单里没有对应社团，
//    这里临时挂在 C03 拾光摄影社 / 若要严谨，可在实体清单补一个 C04 跑者联盟，再把这条改成 C04`。
// 3) 02_seed_entities.cypher 里 A04 活动节点本来就在（`{id: 'A04', name: '夜跑打卡周'}`），
//    所以缺的不是节点「A04」，而是**社团节点 C04**；同时 A04 与 C03 之间那条 HOSTS 是写错的，
//    要改挂到 C04。
// 4) club-ontology.jsonld 里 Club 类的 dsh:instances 只有 C01/C02/C03 三个实例，
//    也印证缺的是社团实例。
// 因此本次改动＝1 个新节点（C04 跑者联盟）+ 2 条关系（HOSTS 改挂、TAGGED_WITH 新增）。
// 注：C04 目前不带成员/社长——补成员需要新增学生节点，会改变现有 8 人样例的口径
//     （F32「一人多社团」样例目前只有陈嘉禾一人），故本次不动，已列入待确认。
// ============================================================
